Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Semua request ke api/ diarahkan ke index.php (termasuk lib/, config.php, dll.)
  RewriteCond %{REQUEST_URI} !/index\.php$
  RewriteRule ^ index.php [QSA,L]
</IfModule>

# Cadangan kalau mod_rewrite mati: blokir akses langsung ke file selain index.php
<FilesMatch "^(?!index\.php$).+\.php$">
  Require all denied
</FilesMatch>
